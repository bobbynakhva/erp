modules = ["web", "nodejs-22", "python-base-3.13", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd smart-erp && PORT=5000 CHROME_PATH=\"$(command -v chromium)\" node --require ./preview-alias.cjs server.js"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 5000
